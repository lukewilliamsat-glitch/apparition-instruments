{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "origin",
    "requests",
    "limits"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "kind": {
      "const": "atlas-public-static-capture"
    },
    "origin": {
      "const": "https://apparitioninstruments.co.uk"
    },
    "requests": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "contentType"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "contentType": {
            "type": "string",
            "minLength": 1
          },
          "expectedSHA256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxRequests",
        "maxResponseBytes",
        "maxTotalBytes",
        "timeoutMs"
      ],
      "properties": {
        "maxRequests": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "maxResponseBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8388608
        },
        "maxTotalBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 33554432
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 15000
        }
      }
    }
  }
}
