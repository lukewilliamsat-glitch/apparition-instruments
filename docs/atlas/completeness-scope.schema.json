{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "categories",
    "emptyCategoryReasons",
    "inventoryAuthority",
    "inventoryReference",
    "versionCompatibilityReviewed",
    "unknownPaths",
    "excludedPaths",
    "artifactReview"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "kind": {
      "const": "atlas-completeness-scope"
    },
    "categories": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "routes",
        "protectedContent",
        "productImages",
        "news",
        "cms",
        "checkout",
        "staticAssets"
      ],
      "properties": {
        "routes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "protectedContent": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "productImages": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "news": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "cms": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "checkout": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "staticAssets": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "emptyCategoryReasons": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "inventoryAuthority": {
      "enum": [
        "unattested",
        "owner-reviewed"
      ]
    },
    "inventoryReference": {
      "type": "string"
    },
    "versionCompatibilityReviewed": {
      "type": "boolean"
    },
    "unknownPaths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "excludedPaths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "artifactReview": {
      "type": [
        "object",
        "null"
      ]
    }
  }
}
