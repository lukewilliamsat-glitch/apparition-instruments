{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "files"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "kind": {
      "const": "atlas-recovery-provenance"
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256",
          "sourceType",
          "sourceId",
          "revision"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "sourceType": {
            "enum": [
              "verified-deployed-artifact",
              "verified-historical-repository-object",
              "publicly-observed-live-bytes",
              "candidate-reconstructed-file",
              "synthetic-fixture"
            ]
          },
          "sourceId": {
            "type": "string",
            "minLength": 1
          },
          "revision": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
